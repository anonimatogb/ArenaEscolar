<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InterClass.App.Calendario"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO E INFORMAÇÕES -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="16,12,16,8"
                             Spacing="12">

            <!-- Cabeçalho personalizado -->
            <Grid ColumnDefinitions="44,*,44"
                  HeightRequest="48"
                  VerticalOptions="Center">

                <!-- Logo -->
                <Image Source="logo.png"
                       Grid.Column="2"
                       WidthRequest="68"
                       HeightRequest="68"
                       Aspect="AspectFit"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>

                <!-- Título -->
                <Label Grid.Column="1"
                       Text="CALENDÁRIO"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Secondary}"
                       VerticalOptions="Center"
                       />

                <!-- Voltar -->
                <Button Grid.Column="0"
                        ImageSource="seta.png"
                        HorizontalOptions="Start"
                        HeightRequest="32"
                        WidthRequest="38"
                        BackgroundColor="Transparent"
                        Padding="2"
                        Clicked="Botao_Voltar"/>

            </Grid>

            <!-- Filtro compacto -->
            <VerticalStackLayout HorizontalOptions="End"
                     Spacing="5"
                     ZIndex="10">

                <Label Text="Filtrar"
           FontSize="11"
           FontAttributes="Bold"
           TextColor="{StaticResource TextSecondary}"
           Margin="3,0,0,0"/>

                <Border BackgroundColor="{StaticResource White}"
            Stroke="#E2E8F0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            WidthRequest="190"
            HeightRequest="40"
            Padding="10,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AbrirFiltro_Clicked"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center">

                        <Label Text="{Binding FiltroSelecionado}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center"/>

                        <Label Grid.Column="1"
                   Text="⌄"
                   FontSize="19"
                   TextColor="{StaticResource Primary}"
                   VerticalOptions="Center"/>

                    </Grid>

                </Border>

                <!-- OPÇÕES DO FILTRO -->
                <Border BackgroundColor="{StaticResource White}"
            Stroke="#E2E8F0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            Padding="5"
            WidthRequest="190"
            IsVisible="{Binding IsFiltroAberto}">

                    <VerticalStackLayout Spacing="2">

                        <Button Text="Todos os jogos"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    CornerRadius="7"
                    Clicked="TodosJogos_Clicked"/>

                        <BoxView HeightRequest="1"
                     Color="#E2E8F0"/>

                        <Button Text="Jogos da minha sala"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    CornerRadius="7"
                    Clicked="MinhaSala_Clicked"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- Próximo jogo -->
            <Border BackgroundColor="{StaticResource Secondary}"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 14"
                    IsVisible="{Binding TemProximoJogo}">

                <VerticalStackLayout Spacing="8">

                    <Label Text="PRÓXIMO CONFRONTO"
                           TextColor="{StaticResource Primary}"
                           FontSize="11"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding ProximoJogo.DescricaoProximoJogo}"
                           TextColor="White"
                           FontSize="19"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding ProximoJogo.DiaFormatado}"
                           TextColor="#CBD5E1"
                           FontSize="12"/>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="{Binding ProximoJogo.HorarioFormatado}"
                               TextColor="White"
                               FontSize="13"
                               VerticalOptions="Center"/>

                        <Label Grid.Column="1"
                               Text="{Binding ProximoJogo.Quadra}"
                               TextColor="#CBD5E1"
                               FontSize="12"
                               VerticalOptions="Center"/>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Mensagem quando não existe próximo jogo -->
            <Label Text="Nenhum jogo futuro agendado."
                   IsVisible="{Binding TemProximoJogo, Converter={StaticResource InvertedBoolConverter}}"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="12"/>

            <!-- Navegação dos meses -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  VerticalOptions="Center">

                <Button Text="‹"
                        Clicked="MesAnterior_Clicked"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource Secondary}"
                        FontSize="24"
                        WidthRequest="42"
                        HeightRequest="42"
                        CornerRadius="10"/>

                <Label Grid.Column="1"
                       Text="{Binding TituloMes}"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>

                <Button Grid.Column="2"
                        Text="›"
                        Clicked="ProximoMes_Clicked"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource Secondary}"
                        FontSize="24"
                        WidthRequest="42"
                        HeightRequest="42"
                        CornerRadius="10"/>

            </Grid>

            <!-- Legenda -->
            <HorizontalStackLayout Spacing="16">

                <HorizontalStackLayout Spacing="5">

                    <BoxView Color="#F97316"
                             WidthRequest="10"
                             HeightRequest="10"
                             CornerRadius="5"/>

                    <Label Text="Sua sala"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"/>

                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">

                    <BoxView Color="#CBD5E1"
                             WidthRequest="10"
                             HeightRequest="10"
                             CornerRadius="5"/>

                    <Label Text="Outros jogos"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"/>

                </HorizontalStackLayout>

            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- LISTA DOS JOGOS -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Jogos}"
                        Margin="16,0"
                        VerticalScrollBarVisibility="Always">

            <!-- Quando não houver jogos -->
            <CollectionView.EmptyView>

                <VerticalStackLayout Padding="25"
                                     Spacing="8"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="Nenhum jogo neste mês"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           />

                    <Label Text="Os confrontos aparecerão aqui quando forem cadastrados."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- Cartões dos jogos -->
            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border BackgroundColor="{Binding CorFundo}"
                            Stroke="{Binding CorBorda}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14"
                            Margin="0,0,0,12">

                        <VerticalStackLayout Spacing="9">

                            <!-- Data e identificação -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="{Binding DiaFormatado}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>


                            </Grid>

                            <!-- Modalidade -->
                            <Label Text="{Binding Modalidade}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <!-- Confronto -->
                            <Grid ColumnDefinitions="*,Auto,*"
                                  VerticalOptions="Center">

                                <Label Text="{Binding TimeA}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="×"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       Margin="12,0"/>

                                <Label Grid.Column="2"
                                       Text="{Binding TimeB}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"
 
                                       TextColor="{StaticResource TextPrimary}"
                                       
                                       VerticalOptions="Center"/>

                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#E2E8F0"/>

                            <!-- Horário, quadra e status -->
                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="3">

                                    <Label Text="{Binding HorarioFormatado, StringFormat='Horário: {0}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>

                                    <Label Text="{Binding Quadra, StringFormat='Local: {0}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>

                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding StatusExibicao}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
