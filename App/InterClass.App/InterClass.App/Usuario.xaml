<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterClass.App.Usuario"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- LOGO / MARCA TOPO -->
            <Button ImageSource="seta.png"
        HorizontalOptions="Start"            
        HeightRequest="28"
        FontSize="13"
        CornerRadius="8"
        Padding="2,0"
        Margin="0,0,0,0"
                    TextColor="{StaticResource Primary}"
        Clicked="IrMainPage"/>

            <!-- LOGO / MARCA TOPO -->
            <HorizontalStackLayout Spacing="8" Margin="0,10,0,0" HorizontalOptions="Center">
                <Image Source="logo.png" HeightRequest="90"/>
            </HorizontalStackLayout>


            <!-- FORMULÁRIO -->
            <VerticalStackLayout Spacing="16" Margin="0,10,0,0">

                <!-- Campo RM -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="MUDE SUA SENHA" 
                       TextColor="{StaticResource Primary}" 
                       FontSize="11" 
                       FontAttributes="Bold" /> 
                </VerticalStackLayout>

                <!-- Campo Senha -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nova senha" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                    <Entry Placeholder="••••••••••"
                           Text="{Binding Password}"
                           x:Name="NovaSenha_Entry"
                           IsPassword="True"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirmar nova senha" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                    <Entry Placeholder="••••••••••"
                       Text="{Binding Password}"
                       x:Name="ConfirmarSenha_Entry"
                       IsPassword="True"/>
                </VerticalStackLayout>

                <!-- Botão Entrar Principal -->
                <Button Text="Alterar"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding LoginCommand}" 
                        Margin="0,8,0,0"
                        Clicked="Botao_Alterar"/>


            </VerticalStackLayout>

            <!-- DIVISOR SUTIL -->
            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,10"/>

            <Button Text="Sair da Conta"
        BackgroundColor="{StaticResource Error}"
        Command="{Binding LoginCommand}" 
        Margin="0,8,0,0"
        Clicked="Botao_Sair"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>